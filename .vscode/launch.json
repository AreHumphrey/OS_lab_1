{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug hello-world",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/hello-world.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
